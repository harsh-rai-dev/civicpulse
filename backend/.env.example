# Backend Environment Variables Example

# The port the backend server will listen on (default: 4000)
PORT=4000

# The path to the JSON database file (default: ./data.json)
DB_PATH=./data.json

# Secret key used for signing JWT tokens (must be a long random string; generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here

# EmailJS configuration for sending password reset OTPs
# Get these from your EmailJS dashboard (https://www.emailjs.com/)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
